# ---------------------------------------------------------------------------
#  NocturneLdr default-payload network triage rules.
# ---------------------------------------------------------------------------
#  NocturneLdr ships with an embedded XOR-encrypted msfvenom payload. Common
#  defaults are windows/x64/shell_reverse_tcp and windows/x64/meterpreter_*
#  variants. These rules target the network-side artifacts of those default
#  payloads, *not* the loader itself (loader artifacts are covered by
#  rules/yara/nocturne.yar on the artifact side).
#
#  All rules are tagged `nocturneldr` so they can be filtered by the
#  detection pipeline and by SOC analysts during triage.
# ---------------------------------------------------------------------------

# --- 1. msfvenom HTTPS staging URI (meterpreter_reverse_https default) -----
#  Meterpreter staging URIs default to /<4-8 alphanumerics>/. Combined with a
#  non-browser User-Agent this is a strong C2 staging signal. Legitimate
#  services rarely expose single-segment random alphabetic URIs on
#  high-numbered ports.
alert http $HOME_NET any -> $EXTERNAL_NET any ( msg:"NOCTURNE Possible msfvenom Meterpreter HTTPS staging URI"; flow:to_server,established; http.uri; content:"/"; http.uri; pcre:"/^\/[A-Za-z0-9]{4,8}\/?/$"; classtype:trojan-activity; metadata:mitre_technique_id T1071.001, mitre_tactic_id TA0011; reference:url,github.com/din4e/c2-signal; sid:1000001; rev:1; )

# --- 2. shell_reverse_tcp banner on non-standard port ------------------------
#  windows/x64/shell_reverse_tcp immediately sends a Windows version banner
#  after handshake. The default LPORT is 4444, but the family commonly uses
#  arbitrary high ports. Detecting the "Microsoft Windows" version string on
#  any non-service port is a strong C2 indicator.
alert tcp $HOME_NET any -> $EXTERNAL_NET [!80,!443,!53,!25,!587,!465,!993,!995] ( msg:"NOCTURNE Possible msfvenom shell_reverse_tcp banner"; flow:to_server,established; content:"Microsoft Windows"; nocase; offset:0; classtype:trojan-activity; metadata:mitre_technique_id T1071, mitre_tactic_id TA0011; reference:url,github.com/din4e/c2-signal; sid:1000002; rev:1; )

# --- 3. Anomalous outbound TCP to high ports within seconds of process start -
#  NocturneLdr's payload thread fires NtWaitForSingleObject inside the loader
#  before the network call. From the network perspective the outbound TCP
#  appears immediately after the loader image is mapped. Pairing high-port
#  outbound connections with the loader process lifetime is hunt-grade, not
#  verdict-grade.
alert tcp $HOME_NET any -> $EXTERNAL_NET 1024:65535 ( msg:"NOCTURNE Outbound TCP to high port (hunting)"; flow:to_server,established; threshold:type both, track by_src, count 1, seconds 60; classtype:misc-activity; metadata:mitre_technique_id T1071, mitre_tactic_id TA0011; reference:url,github.com/din4e/c2-signal; sid:1000003; rev:1; )

# --- 4. msfvenom reverse_https default User-Agent ----------------------------
#  The default Meterpreter reverse_https payload uses a Windows-shaped
#  User-Agent. Combined with the staging URI rule above this raises confidence.
alert http $HOME_NET any -> $EXTERNAL_NET any ( msg:"NOCTURNE Possible msfvenom reverse_https default User-Agent"; flow:to_server,established; http.user_agent; content:"Mozilla/5.0"; nocase; http.user_agent; content:"Windows NT"; nocase; http.uri; pcre:"/^\/[A-Za-z0-9]{4,8}\/?/$"; classtype:trojan-activity; metadata:mitre_technique_id T1071.001, mitre_tactic_id TA0011; reference:url,github.com/din4e/c2-signal; sid:1000004; rev:1; )
